<Window x:Class="GuiApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pokemon Info" Height="450" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="ID:"/>
            <TextBlock Text="{Binding CurrentPokemon.Id}" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="German Name:"/>
            <TextBlock Text="{Binding CurrentPokemon.Name}" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="German Flavor Text:"/>
            <TextBlock Text="{Binding CurrentPokemon.FlavorText}" 
                     TextWrapping="Wrap" FontSize="14"/>
        </StackPanel>

        <Image Grid.Row="3" 
               Source="{Binding CurrentPokemon.ImagePath}"
               Width="150" Height="150"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Content="Previous" 
                    Command="{Binding PreviousCommand}"
                    Width="100" Height="30"
                    HorizontalAlignment="Left"/>
            
            <Button Grid.Column="1" Content="Next" 
                    Command="{Binding NextCommand}"
                    Width="100" Height="30"
                    HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
